# Server
PORT=4000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:3000

# MongoDB (Atlas free tier in production, local mongod in dev)
MONGODB_URI=mongodb://127.0.0.1:27017/ai-interview-kit

# Session auth (express-session + connect-mongo) — any long random string
SESSION_SECRET=change-me-to-a-long-random-string

# LLM provider used for the generation pipeline. "openai" is wired up now;
# "gemini" is a stub for swapping to a genuine free tier later — see README.
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Tavily search API — used to find public discussion of a company's interview process.
TAVILY_API_KEY=

# Optional page classifier upgrade (falls back to a free heuristic if unset/failing).
USE_JEV_CLASSIFIER=false
JEV_API_KEY=

# Allows fetching private/loopback company URLs (e.g. http://localhost:8099/acme/)
# for local dev and the batch harness. Must be false/unset in any real deployment —
# see Section 11 of the brief (SSRF guard).
ALLOW_LOCAL_HOSTS=false

# Pipeline tuning
MAX_CRAWL_PAGES=8
MAX_COVERAGE_PASSES=3
BATCH_CONCURRENCY=2
MAX_CONCURRENT_GENERATIONS=2
